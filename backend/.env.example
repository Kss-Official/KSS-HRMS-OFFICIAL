DATABASE_URL=postgresql+asyncpg://user:password@host/neondb?ssl=require
DATABASE_URL_UNPOOLED=postgresql+asyncpg://user:password@host/neondb?ssl=require
SECRET_KEY=your-super-secret-jwt-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://kalpanaaa.in"]
GEOFENCE_LAT=12.9121
GEOFENCE_LON=77.6446
GEOFENCE_RADIUS_METERS=100
COMPANY_TIMEZONE=Asia/Kolkata

FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
