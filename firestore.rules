rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ─────────────────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function hasEmail() {
      return isSignedIn() && 'email' in request.auth.token && request.auth.token.email != null;
    }
    function userEmail() {
      return hasEmail() ? request.auth.token.email : '';
    }
    function emailMatches(targetEmail) {
      return hasEmail() && targetEmail is string && targetEmail != '' &&
        targetEmail.lower() == userEmail().lower();
    }
    function isRealUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function employeeRecord(docId) {
      return get(/databases/$(database)/documents/employees/$(docId)).data;
    }
    function authOwnsEmployeeRecord(employeeDocId) {
      return isRealUser() &&
        employeeDocId is string && employeeDocId != '' &&
        exists(/databases/$(database)/documents/employees/$(employeeDocId)) &&
        (
          employeeRecord(employeeDocId).get('uid', '~') == request.auth.uid ||
          employeeRecord(employeeDocId).get('employeeUid', '~') == request.auth.uid ||
          emailMatches(employeeRecord(employeeDocId).get('email', '')) ||
          emailMatches(employeeRecord(employeeDocId).get('workEmail', '')) ||
          emailMatches(employeeRecord(employeeDocId).get('personalEmail', ''))
        );
    }
    function trustedUserMapping(d) {
      let employeeDocId = d.get('employeeDocId', '');
      return isRealUser() &&
        d.get('uid', '') == request.auth.uid &&
        (!hasEmail() || d.get('email', '').lower() == userEmail().lower()) &&
        employeeDocId is string && employeeDocId != '' &&
        exists(/databases/$(database)/documents/employees/$(employeeDocId)) &&
        d.get('employeeId', '~') == employeeRecord(employeeDocId).get('employeeId', '~~') &&
        d.get('role', '~') == employeeRecord(employeeDocId).get('role', '~~') &&
        (
          // Email match against the employee record is sufficient — the auth token
          // email is Firebase-trusted and proves identity without needing a uid
          // field pre-populated on the employee document (seeded docs lack it).
          authOwnsEmployeeRecord(employeeDocId) ||
          (
            hasEmail() && request.auth.token.email.lower() == 'abhinayav1919@kalpanaaa.in' &&
            employeeDocId == 'emp-KSS2407011'
          )
        );
    }
    // Relaxed mapping for the initial users/{uid} self-create where the employee
    // document exists and the auth token email matches one of its email fields,
    // but the employee doc doesn't yet have a uid field set.
    function trustedUserMappingForCreate(d) {
      let employeeDocId = d.get('employeeDocId', '');
      return isRealUser() &&
        d.get('uid', '') == request.auth.uid &&
        (!hasEmail() || d.get('email', '').lower() == userEmail().lower()) &&
        employeeDocId is string && employeeDocId != '' &&
        exists(/databases/$(database)/documents/employees/$(employeeDocId)) &&
        d.get('employeeId', '~') == employeeRecord(employeeDocId).get('employeeId', '~~') &&
        d.get('role', '~') == employeeRecord(employeeDocId).get('role', '~~') &&
        (
          // uid match: already linked
          employeeRecord(employeeDocId).get('uid', '~') == request.auth.uid ||
          employeeRecord(employeeDocId).get('employeeUid', '~') == request.auth.uid ||
          // Email match: auth token email is Firebase-trusted proof of identity
          (hasEmail() && (
            emailMatches(employeeRecord(employeeDocId).get('email', '')) ||
            emailMatches(employeeRecord(employeeDocId).get('workEmail', '')) ||
            emailMatches(employeeRecord(employeeDocId).get('personalEmail', ''))
          )) ||
          // Special HR alias
          (hasEmail() && request.auth.token.email.lower() == 'abhinayav1919@kalpanaaa.in' &&
            employeeDocId == 'emp-KSS2407011')
        );
    }
    function userDocExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        trustedUserMapping(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function empDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/employees/$(request.auth.uid));
    }
    function getEmpDoc() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data;
    }
    function getEmployeeId() {
      return userDocExists()
        ? (('employeeId' in getUserDoc()) && getUserDoc().employeeId != null ? getUserDoc().employeeId : null)
        : (empDocExists()
            ? (('employeeId' in getEmpDoc()) && getEmpDoc().employeeId != null ? getEmpDoc().employeeId : null)
            : null);
    }
    function getEmployeeDocId() {
      return userDocExists()
        ? (('employeeDocId' in getUserDoc()) && getUserDoc().employeeDocId != null ? getUserDoc().employeeDocId : (empDocExists() ? request.auth.uid : null))
        : (empDocExists() ? request.auth.uid : null);
    }
    function hasClaimRole() {
      return isSignedIn() && ('role' in request.auth.token) && request.auth.token.role != null;
    }
    function getRole() {
      return hasClaimRole()
        ? request.auth.token.role
        : (userDocExists()
            ? (('role' in getUserDoc()) && getUserDoc().role != null ? getUserDoc().role : null)
            : (empDocExists() ? getEmpDoc().get('role', null) : null));
    }

    // ── Role predicates ──────────────────────────────────────────────────────
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid in ['2kNsj2o55VRtEy2rTnz4CPk7se23', 'sco3JJEikROXFMSkCbe7flK62w53', 'hOjKhSAtZKN7igNaePAmPKprVbp1'] ||
        (hasEmail() && (
          userEmail().lower() in [
            'gaurav@kalpanaaa.in', 'gaurav@kalpanaaasoftwaresolutions.in',
            'founder@kalpanaaasoftwaresolutions.in', 'founder@kalpanaaa.in',
            'akshitujjain@kalpanaaasoftwaresolutions.in', 'akshit.ujjain@kalpanaaasoftwaresolutions.in',
            'akshit@kalpanaaa.in', 'akshit.ujjain@kalpanaaa.in',
            'cto@kalpanaaa.in', 'cto@kalpanaaasoftwaresolutions.in'
          ]
        )) ||
        (hasClaimRole() && request.auth.token.role in ['SUPER_ADMIN', 'superadmin']) ||
        getRole() == 'SUPER_ADMIN' ||
        (empDocExists() && (('role' in getEmpDoc()) && getEmpDoc().role == 'SUPER_ADMIN'))
      );
    }
    function isHrAdmin() {
      return isSignedIn() && (
        request.auth.uid in ['2d48Rm9eY4eBswXOZw2IBpWGkZK2', '3ZHI3aTB37StHjR97WEBJQSWT9H3'] ||
        (hasEmail() && (
          userEmail().lower() in [
            'hr@kalpanaaa.in', 'hr@kalpanaaasoftwaresolutions.in',
            'abhinayav1919@kalpanaaa.in', 'abhinayav1919@kalpanaaasoftwaresolutions.in'
          ]
        )) ||
        (hasClaimRole() && request.auth.token.role in ['HR_ADMIN', 'hr_admin', 'hr']) ||
        getRole() == 'HR_ADMIN' ||
        isSuperAdmin() ||
        (empDocExists() && (('role' in getEmpDoc()) && getEmpDoc().role in ['HR_ADMIN', 'SUPER_ADMIN']))
      );
    }
    function isProjectManager() {
      return isSignedIn() && (
        request.auth.uid in ['vhKLIJCVZoTncqVtmh14paMbiXk2'] ||
        (hasEmail() && (
          userEmail().lower() in [
            'd.koushik@kalpanaaasoftwaresolutions.in',
            'd.koushik@kalpanaaa.in',
            'koushik@kalpanaaa.in',
            'koushik@kalpanaaasoftwaresolutions.in'
          ]
        )) ||
        (hasClaimRole() && request.auth.token.role in ['PROJECT_MANAGER', 'project_manager', 'pm']) ||
        getRole() == 'PROJECT_MANAGER' ||
        isSuperAdmin() ||
        (empDocExists() && (('role' in getEmpDoc()) && getEmpDoc().role == 'PROJECT_MANAGER'))
      );
    }
    function isAuthorizedTechLead() {
      return isSignedIn() && (
        request.auth.uid in ['QpDtyS6Jp5OqNu3klvfWGoWHfmS2', 'KfAB95lpbJOeylpKQaWX4GXOPGt2'] ||
        (hasEmail() && (
          userEmail().lower() in [
            'satya.ranjan.dash@kalpanaaa.in',
            'satya.ranjan.das@kalpanaaa.in',
            'satya@kalpanaaa.in',
            'satya.ranjan.dash@kalpanaaasoftwaresolutions.in',
            'jasonkennethn@kalpanaaa.in',
            'jason.kennethn@kalpanaaa.in',
            'jasonkennethn@kalpanaaasoftwaresolutions.in'
          ]
        )) ||
        (empDocExists() && (
          getEmpDoc().get('email', '') in ['satya.ranjan.dash@kalpanaaa.in', 'satya.ranjan.das@kalpanaaa.in', 'jasonkennethn@kalpanaaa.in'] ||
          getEmpDoc().get('role', '') == 'TECH_LEAD'
        )) ||
        (userDocExists() && (
          getUserDoc().get('role', '') == 'TECH_LEAD' ||
          getUserDoc().get('email', '') in ['satya.ranjan.dash@kalpanaaa.in', 'satya.ranjan.das@kalpanaaa.in', 'jasonkennethn@kalpanaaa.in']
        ))
      );
    }
    function isConfigAdmin() { return isHrAdmin() || isSuperAdmin(); }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function unchanged(f) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([f]);
    }

    // ── Ownership helpers ────────────────────────────────────────────────────
    function ownsEmployeeRecord(employeeId) {
      return isSignedIn() && (
        request.auth.uid == employeeId ||
        (resource != null && (
          resource.data.get('uid', '~') == request.auth.uid ||
          resource.data.get('employeeUid', '~') == request.auth.uid ||
          emailMatches(resource.data.get('email', '')) ||
          emailMatches(resource.data.get('workEmail', '')) ||
          emailMatches(resource.data.get('personalEmail', ''))
        )) ||
        (getEmployeeDocId() != null && (
          employeeId == getEmployeeDocId() ||
          (resource != null && resource.data.get('employeeDocId', '~') == getEmployeeDocId())
        )) ||
        (getEmployeeId() != null && (
          employeeId == getEmployeeId() ||
          employeeId == ('emp-' + getEmployeeId()) ||
          (resource != null && (
            resource.data.get('employeeId', '~') == getEmployeeId() ||
            resource.data.get('employeeCode', '~') == getEmployeeId()
          ))
        )) ||
        (userDocExists() && (
          getUserDoc().get('employeeDocId', '~') == employeeId ||
          (resource != null && resource.data.get('employeeId', '~') != '~' && resource.data.get('employeeId', '~') == getUserDoc().get('employeeId', '~~'))
        ))
      );
    }
    function ownsAttendanceDocId(recordId) {
      let parts = recordId.split('_');
      let prefix = parts[0];
      return prefix == request.auth.uid ||
        authOwnsEmployeeRecord(prefix) ||
        (getEmployeeDocId() != null && prefix == getEmployeeDocId()) ||
        (getEmployeeDocId() != null &&
          employeeRecord(getEmployeeDocId()).get('uid', '~') == prefix) ||
        (getEmployeeId() != null && (prefix == getEmployeeId() || prefix == ('emp-' + getEmployeeId()))) ||
        (userDocExists() && (
          ('employeeId' in getUserDoc() && (prefix == getUserDoc().employeeId || prefix == ('emp-' + getUserDoc().employeeId))) ||
          ('employeeDocId' in getUserDoc() && prefix == getUserDoc().employeeDocId) ||
          ('uid' in getUserDoc() && prefix == getUserDoc().uid)
        )) ||
        (empDocExists() && (
          ('employeeId' in getEmpDoc() && (prefix == getEmpDoc().employeeId || prefix == ('emp-' + getEmpDoc().employeeId)))
        ));
    }
    function ownsAttendanceCreateDocId(recordId, employeeDocId, date) {
      return date is string && date.size() == 10 &&
        (
          recordId == request.auth.uid + '_' + date ||
          recordId == employeeDocId + '_' + date
        );
    }
    function ownsAttendanceData(d) {
      return isRealUser() && (
        d.get('uid', '~') == request.auth.uid ||
        d.get('employeeUid', '~') == request.auth.uid ||
        d.get('authUid', '~') == request.auth.uid ||
        d.get('employeeId', '~') == request.auth.uid ||
        emailMatches(d.get('email', '')) ||
        emailMatches(d.get('employeeEmail', '')) ||
        (getEmployeeId() != null && (
          d.get('employeeCode', '~') == getEmployeeId() ||
          d.get('employeeId', '~') == getEmployeeId() ||
          d.get('employeeId', '~') == ('emp-' + getEmployeeId())
        )) ||
        (getEmployeeDocId() != null && (
          d.get('employeeId', '~') == getEmployeeDocId() ||
          d.get('employeeDocId', '~') == getEmployeeDocId() ||
          d.get('uid', '~') == getEmployeeDocId() ||
          d.get('employeeUid', '~') == getEmployeeDocId()
        )) ||
        (userDocExists() && (
          ('employeeId' in getUserDoc() && (
            d.get('employeeCode', '~') == getUserDoc().employeeId ||
            d.get('employeeId', '~') == getUserDoc().employeeId ||
            d.get('employeeId', '~') == ('emp-' + getUserDoc().employeeId)
          )) ||
          ('employeeDocId' in getUserDoc() && (
            d.get('employeeId', '~') == getUserDoc().employeeDocId ||
            d.get('employeeDocId', '~') == getUserDoc().employeeDocId ||
            d.get('uid', '~') == getUserDoc().employeeDocId ||
            d.get('employeeUid', '~') == getUserDoc().employeeDocId
          ))
        )) ||
        (empDocExists() && (
          ('employeeId' in getEmpDoc() && (
            d.get('employeeCode', '~') == getEmpDoc().employeeId ||
            d.get('employeeId', '~') == getEmpDoc().employeeId ||
            d.get('employeeId', '~') == ('emp-' + getEmpDoc().employeeId)
          ))
        ))
      );
    }
    function ownsSalaryRecord(d) {
      return isRealUser() && (
        d.get('employeeUid', '~') == request.auth.uid ||
        d.get('uid', '~') == request.auth.uid ||
        d.get('employeeId', '~') == request.auth.uid ||
        emailMatches(d.get('email', '')) ||
        emailMatches(d.get('employeeEmail', '')) ||
        (getEmployeeId() != null && (
          d.get('employeeId', '~') == getEmployeeId() ||
          d.get('employeeId', '~') == ('emp-' + getEmployeeId())
        )) ||
        (getEmployeeDocId() != null && (
          d.get('employeeDocId', '~') == getEmployeeDocId() ||
          d.get('employeeId', '~') == getEmployeeDocId()
        ))
      );
    }
    function ownsFcmToken(d) {
      return isRealUser() && (
        d.get('uid', '~') == request.auth.uid ||
        d.get('employeeUid', '~') == request.auth.uid ||
        d.get('employeeId', '~') == request.auth.uid ||
        (getEmployeeId() != null && d.get('employeeId', '~') == getEmployeeId()) ||
        (getEmployeeDocId() != null && d.get('employeeId', '~') == getEmployeeDocId())
      );
    }

    // ── ownsLeaveRequest — UID-anchored fast-path with robust fallbacks ───────
    // Fast UID check evaluates first (0 cross-doc reads in atomic transactions).
    // Secondary identifier fallbacks handle legacy requests and docId representations.
    function ownsLeaveRequest(d) {
      return isRealUser() && (
        d.get('employeeUid', '~') == request.auth.uid ||
        d.get('authUid', '~') == request.auth.uid ||
        d.get('uid', '~') == request.auth.uid ||
        d.get('employeeId', '~') == request.auth.uid ||
        emailMatches(d.get('employeeEmail', '')) ||
        emailMatches(d.get('email', '')) ||
        (getEmployeeId() != null && (
          d.get('employeeId', '~') == getEmployeeId() ||
          d.get('employeeId', '~') == ('emp-' + getEmployeeId()) ||
          d.get('employeeCode', '~') == getEmployeeId()
        )) ||
        (getEmployeeDocId() != null && (
          d.get('employeeId', '~') == getEmployeeDocId() ||
          d.get('employeeDocId', '~') == getEmployeeDocId()
        )) ||
        (userDocExists() && (
          ('employeeId' in getUserDoc() && (
            d.get('employeeId', '~') == getUserDoc().employeeId ||
            d.get('employeeId', '~') == ('emp-' + getUserDoc().employeeId) ||
            d.get('employeeCode', '~') == getUserDoc().employeeId
          )) ||
          ('employeeDocId' in getUserDoc() && (
            d.get('employeeId', '~') == getUserDoc().employeeDocId ||
            d.get('employeeDocId', '~') == getUserDoc().employeeDocId
          ))
        ))
      );
    }
    function ownsNotification(d) {
      return isRealUser() && (
        d.get('recipientUid', '~') == request.auth.uid ||
        d.get('targetEmployeeUid', '~') == request.auth.uid ||
        d.get('targetEmployeeId', '~') == request.auth.uid ||
        d.get('actorId', '~') == request.auth.uid ||
        d.get('createdByUid', '~') == request.auth.uid ||
        (getEmployeeId() != null && (
          d.get('recipientEmployeeId', '~') == getEmployeeId() ||
          d.get('targetEmployeeId', '~') == getEmployeeId() ||
          d.get('actorId', '~') == getEmployeeId()
        )) ||
        (getEmployeeDocId() != null && (
          d.get('recipientEmployeeId', '~') == getEmployeeDocId() ||
          d.get('targetEmployeeId', '~') == getEmployeeDocId() ||
          d.get('actorId', '~') == getEmployeeDocId()
        ))
      );
    }
    // ── Shape validators ─────────────────────────────────────────────────────
    function validBreakEntry(breakEntry) {
      return breakEntry is map &&
        breakEntry.keys().hasOnly([
          'type', 'startAt', 'startTime', 'endAt', 'endTime', 'durationMinutes'
        ]) &&
        ('type' in breakEntry) &&
        breakEntry.type in [
          'Tea Break', 'Snack Break', 'Meal Break', 'Lunch Break',
          'Team Huddle', 'Team Meeting', 'Attainment / Training', 'Activity'
        ] &&
        (
          ('startAt' in breakEntry && (breakEntry.startAt is string || breakEntry.startAt is timestamp)) ||
          ('startTime' in breakEntry && (breakEntry.startTime is string || breakEntry.startTime is timestamp))
        ) &&
        (
          !('endAt' in breakEntry) ||
          breakEntry.endAt == null ||
          breakEntry.endAt == '' ||
          breakEntry.endAt is string ||
          breakEntry.endAt is timestamp
        ) &&
        (
          !('durationMinutes' in breakEntry) ||
          (breakEntry.durationMinutes is number && breakEntry.durationMinutes >= 0 && breakEntry.durationMinutes <= 720)
        );
    }
    function validAttendanceCreateForOwner(recordId) {
      let d = request.resource.data;
      let employeeDocId = d.get('employeeId', '');
      return d.keys().hasOnly([
        'id', 'uid', 'employeeUid', 'authUid', 'email', 'employeeEmail',
        'employeeId', 'employeeCode', 'employeeName', 'department', 'pmUid',
        'date', 'checkInAt', 'checkOutAt', 'workingMinutes', 'status',
        'attendanceMethod', 'officeLatitude', 'officeLongitude',
        'officeRadiusMeters', 'distanceFromOffice', 'locationAccuracy',
        'locationVerified', 'latitude', 'longitude', 'deviceInfo', 'breaks',
        'totalBreakMinutes', 'isWfh', 'createdAt', 'updatedAt', 'notes'
      ]) &&
      authOwnsEmployeeRecord(employeeDocId) &&
      ownsAttendanceCreateDocId(recordId, employeeDocId, d.get('date', '')) &&
      d.get('employeeCode', '') is string &&
      d.get('employeeCode', '') != '' &&
      d.get('employeeCode', '') == employeeRecord(employeeDocId).get('employeeId', '') &&
      d.get('authUid', '') == request.auth.uid &&
      d.get('uid', '') in [request.auth.uid, employeeDocId] &&
      d.get('employeeUid', '') in [request.auth.uid, employeeDocId] &&
      d.get('checkInAt', null) != null &&
      d.get('checkOutAt', null) == null &&
      d.get('breaks', []) is list &&
      d.get('breaks', []).size() == 0 &&
      d.get('workingMinutes', -1) is number &&
      d.get('workingMinutes', -1) == 0 &&
      d.get('totalBreakMinutes', -1) == 0;
    }
    function validAttendanceSelfUpdate() {
      let d = request.resource.data;
      let old = resource.data;
      let changed = d.diff(old).affectedKeys();
      let newBreaks = d.get('breaks', []);
      let oldBreaks = old.get('breaks', []);
      return changed.hasOnly([
        'checkOutAt', 'workingMinutes', 'breaks', 'totalBreakMinutes',
        'notes', 'updatedAt', 'status', 'officeLatitude', 'officeLongitude',
        'officeRadiusMeters', 'distanceFromOffice', 'locationAccuracy',
        'locationVerified'
      ]) &&
      unchanged('id') &&
      unchanged('uid') &&
      unchanged('employeeUid') &&
      unchanged('authUid') &&
      unchanged('email') &&
      unchanged('employeeEmail') &&
      unchanged('employeeId') &&
      unchanged('employeeCode') &&
      unchanged('employeeName') &&
      unchanged('department') &&
      unchanged('pmUid') &&
      unchanged('date') &&
      unchanged('checkInAt') &&
      unchanged('createdAt') &&
      old.get('checkInAt', null) != null &&
      (
        old.get('checkOutAt', null) == null ||
        old.get('checkOutAt', null) == ''
      ) &&
      (
        (
          changed.hasAny(['checkOutAt']) &&
          d.get('checkOutAt', null) != null &&
          d.get('workingMinutes', -1) is number &&
          d.get('workingMinutes', -1) >= 0 &&
          d.get('workingMinutes', -1) <= 1440 &&
          d.get('totalBreakMinutes', -1) is number &&
          d.get('totalBreakMinutes', -1) >= 0 &&
          d.get('totalBreakMinutes', -1) <= 1440
        ) ||
        (
          changed.hasAny(['breaks']) &&
          (
            d.get('checkOutAt', null) == null ||
            d.get('checkOutAt', null) == ''
          ) &&
          newBreaks is list &&
          newBreaks.size() > 0 &&
          newBreaks.size() <= oldBreaks.size() + 1 &&
          newBreaks.size() <= 100 &&
          validBreakEntry(newBreaks[newBreaks.size() - 1]) &&
          (
            (
              newBreaks.size() == oldBreaks.size() + 1 &&
              (
                !('endAt' in newBreaks[newBreaks.size() - 1]) ||
                newBreaks[newBreaks.size() - 1].endAt == null ||
                newBreaks[newBreaks.size() - 1].endAt == ''
              )
            ) ||
            (
              newBreaks.size() == oldBreaks.size() &&
              oldBreaks.size() > 0 &&
              validBreakEntry(oldBreaks[oldBreaks.size() - 1]) &&
              (
                ('endAt' in newBreaks[newBreaks.size() - 1]) &&
                newBreaks[newBreaks.size() - 1].endAt != null &&
                (
                  newBreaks[newBreaks.size() - 1].endAt is string ||
                  newBreaks[newBreaks.size() - 1].endAt is timestamp
                )
              )
            )
          ) &&
          d.get('totalBreakMinutes', -1) is number &&
          d.get('totalBreakMinutes', -1) >= 0 &&
          d.get('totalBreakMinutes', -1) <= 1440
        )
      );
    }
    function validAttendanceShape() {
      let d = request.resource.data;
      return (!('status' in d) || d.status is string) &&
             (!('date' in d) || (d.date is string && d.date.size() == 10));
    }
    function validLeaveShape() {
      let d = request.resource.data;
      return d.keys().hasOnly([
        'id', 'employeeUid', 'authUid', 'employeeId', 'employeeName',
        'employeeEmail', 'email', 'department', 'employeeRole', 'pmUid',
        'type', 'leaveCategory', 'startDate', 'endDate', 'reason', 'status',
        'requestDate', 'createdAt', 'updatedAt', 'ceoStatus', 'ceoNotes',
        'ceoReviewedBy', 'ceoReviewedAt', 'ctoStatus', 'ctoNotes',
        'ctoReviewedBy', 'ctoReviewedAt', 'pmStatus', 'pmRecommendation',
        'pmNotes', 'pmReviewedBy', 'pmReviewedAt', 'hrStatus', 'hrNotes',
        'hrReviewedBy', 'hrReviewedAt', '_deductionApplied'
      ]) &&
      d.get('status', '') == 'Pending' &&
      d.keys().hasAll(['employeeId', 'employeeUid', 'type', 'startDate', 'endDate', 'reason']) &&
      d.get('employeeUid', '') == request.auth.uid &&
      d.get('employeeId', '') == getEmployeeId() &&
      d.get('type', '') in [
        'Leave', 'WFH', 'Earn Leave', 'Sick Leave', 'Loss of Pay',
        'Casual Leave', 'EL', 'SL', 'LOP'
      ] &&
      d.get('startDate', '') is string && d.get('startDate', '').size() == 10 &&
      d.get('endDate', '') is string && d.get('endDate', '').size() == 10 &&
      d.get('reason', '') is string && d.get('reason', '').size() > 0 &&
      d.get('ceoStatus', 'Pending') == 'Pending' &&
      d.get('ctoStatus', 'Waiting CEO') == 'Waiting CEO' &&
      d.get('pmStatus', 'N/A') == 'N/A' &&
      d.get('hrStatus', 'N/A') == 'N/A' &&
      d.get('_deductionApplied', false) == false;
    }
    function validAuditShape() {
      return request.resource.data.keys().hasOnly([
        'id','actorId','actorName','actorRole','action','target','details','timestamp',
        'performedBy','performedByUid','targetEmployee','targetEmployeeUid',
        'role','ipAddress','userAgent','sessionId','monthKey'
      ]) &&
      request.resource.data.get('action','') is string &&
      request.resource.data.get('action','').size() <= 120 &&
      request.resource.data.get('details','') is string &&
      request.resource.data.get('details','').size() <= 5000;
    }

    // ── 0. Connectivity probe (pre-auth) ─────────────────────────────────────
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /debug_userdoc/{docId} {
      allow create: if userDocExists();
    }
    match /debug_role/{docId} {
      allow create: if getRole() != null;
    }
    match /debug_not_superadmin/{docId} {
      allow create: if !isSuperAdmin();
    }
    match /debug_not_hradmin/{docId} {
      allow create: if !isHrAdmin();
    }
    match /debug_not_pm/{docId} {
      allow create: if !isProjectManager();
    }

    // ── 1. Users (role-mapping) ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSelf(userId) || isHrAdmin() || isProjectManager();
      // Self-create: use relaxed mapping (email proves identity even without uid on employee doc).
      // Self-update of the core mapping fields: also allow relaxed mapping so re-login
      //   refreshes the mapping even if the employee doc uid wasn't yet backfilled.
      allow create: if isConfigAdmin() || isProjectManager() ||
        (isSelf(userId) && trustedUserMappingForCreate(request.resource.data) &&
          request.resource.data.keys().hasOnly([
            'uid', 'email', 'role', 'employeeId', 'employeeDocId', 'fullName', 'updatedAt'
          ]));
      allow update: if isConfigAdmin() || isProjectManager() || (
        isRealUser() && isSelf(userId) && (
          (userDocExists() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profilePhotoUrl', 'updatedAt'])) ||
          (trustedUserMappingForCreate(request.resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'uid', 'email', 'role', 'employeeId', 'employeeDocId', 'fullName', 'updatedAt'
            ]))
        )
      );
      allow delete: if isConfigAdmin() || isProjectManager();
    }

    // ── 2. Employees Directory (PII + biometrics) ───────────────────────────
    match /employees/{employeeId} {
      allow read: if isRealUser();
      allow create: if isConfigAdmin() || isProjectManager() || (
        isRealUser() && isSelf(employeeId) && (
          request.resource.data.role == 'EMPLOYEE' ||
          (userDocExists() && getUserDoc().role == request.resource.data.role)
        )
      );
      allow update: if isConfigAdmin() || isProjectManager() || isAuthorizedTechLead() || (
        (request.auth.uid == employeeId || ownsEmployeeRecord(employeeId)) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'profilePhotoUrl', 'bio', 'phone', 'gender', 'dateOfBirth',
            'permanentAddress', 'currentAddress', 'city', 'state', 'postalCode',
            'emergencyContact', 'emergencyRelationship', 'skills', 'specialization',
            'preferredShift', 'linkedinUrl', 'faceDescriptor', 'isFaceEnrolled',
            'faceEnrolledAt', 'fullName', 'updatedAt', 'hasResume', 'resumeUrl',
            'desktopSessionId', 'mobileSessionId', 'currentSessionId',
            'sessionFingerprint', 'lastLoginAt', 'lastActiveAt',
            // uid backfill: employee may write their own Firebase Auth UID to their
            // own document. This is not a privilege escalation — it only links the
            // auth identity to the existing employee record for rule lookups.
            'uid'
          ])
        )
      );
      allow delete: if isSuperAdmin() || isConfigAdmin() || isProjectManager();

      // 2a. Leave date-locks
      match /leaveLocks/{lockDate} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && (
          isProjectManager() || isConfigAdmin() ||
          employeeId == request.auth.uid ||
          request.resource.data.get('employeeUid','~') == request.auth.uid ||
          request.resource.data.get('authUid','~') == request.auth.uid ||
          emailMatches(request.resource.data.get('email','')) ||
          emailMatches(request.resource.data.get('employeeEmail','')) ||
          (getEmployeeDocId() != null && employeeId == getEmployeeDocId()) ||
          (getEmployeeId() != null && (employeeId == getEmployeeId() || employeeId == ('emp-' + getEmployeeId()))) ||
          request.resource.data.get('employeeId','~') == getEmployeeId() ||
          request.resource.data.get('employeeId','~') == getEmployeeDocId()
        );
        allow delete: if isSignedIn() && (
          isProjectManager() || isConfigAdmin() ||
          employeeId == request.auth.uid ||
          (getEmployeeDocId() != null && employeeId == getEmployeeDocId()) ||
          (getEmployeeId() != null && (employeeId == getEmployeeId() || employeeId == ('emp-' + getEmployeeId()))) ||
          (resource != null && (
            resource.data.get('employeeUid','~') == request.auth.uid ||
            resource.data.get('authUid','~') == request.auth.uid ||
            emailMatches(resource.data.get('email','')) ||
            emailMatches(resource.data.get('employeeEmail','')) ||
            resource.data.get('employeeId','~') == getEmployeeId() ||
            resource.data.get('employeeId','~') == getEmployeeDocId()
          ))
        );
      }

      // 2b. Private resume subcollection
      match /private/{docId} {
        allow read: if isConfigAdmin() || isProjectManager() ||
          (isRealUser() && (employeeId == request.auth.uid || employeeId == getEmployeeDocId() || ownsEmployeeRecord(employeeId)));
        allow write: if isConfigAdmin() || isProjectManager() ||
          (isRealUser() && (employeeId == request.auth.uid || employeeId == getEmployeeDocId() || ownsEmployeeRecord(employeeId)));
      }

      // 2c. Leave Ledger subcollection (audit trail of all EL/SL/CL credits, debits, reversals)
      match /leaveLedger/{txnId} {
        allow read: if isRealUser() && (isConfigAdmin() || isProjectManager() || ownsEmployeeRecord(employeeId));
        allow create: if isSignedIn() && (
          isConfigAdmin() || isProjectManager() || isSuperAdmin() ||
          employeeId == request.auth.uid ||
          (getEmployeeDocId() != null && employeeId == getEmployeeDocId()) ||
          (getEmployeeId() != null && (employeeId == getEmployeeId() || employeeId == ('emp-' + getEmployeeId()))) ||
          request.resource.data.get('employeeUid', '~') == request.auth.uid ||
          request.resource.data.get('authUid', '~') == request.auth.uid ||
          emailMatches(request.resource.data.get('email', '')) ||
          emailMatches(request.resource.data.get('employeeEmail', ''))
        );
        allow update, delete: if isSuperAdmin() || isConfigAdmin() || isProjectManager();
      }
    }

    // ── 3. Attendance Records ────────────────────────────────────────────────
    match /attendance/{recordId} {
      allow read: if isRealUser();
      allow create: if isRealUser() && (
        isProjectManager() || isSuperAdmin() || isHrAdmin() ||
        validAttendanceCreateForOwner(recordId)
      ) && validAttendanceShape() && (
        request.resource.data.get('date', '') == '' ||
        request.resource.data.get('date', '') >= '2026-07-27'
      );
      allow update: if isRealUser() && (
        (
          // Fast path: the stored doc carries authUid, uid, employeeUid == request.auth.uid,
          // or document ID prefix is request.auth.uid.
          // Zero cross-doc reads required — the doc itself proves ownership.
          resource != null &&
          (
            resource.data.get('authUid', '~') == request.auth.uid ||
            resource.data.get('uid', '~') == request.auth.uid ||
            resource.data.get('employeeUid', '~') == request.auth.uid ||
            recordId.split('_')[0] == request.auth.uid
          ) &&
          validAttendanceSelfUpdate()
        ) ||
        isProjectManager() || isSuperAdmin() || isHrAdmin() ||
        // Fallback paths for legacy docs without authUid
        (
          ownsAttendanceDocId(recordId) &&
          (
            recordId.split('_')[0] == request.auth.uid ||
            (
              authOwnsEmployeeRecord(recordId.split('_')[0]) &&
              resource.data.get('authUid', '~') == request.auth.uid
            ) ||
            ownsAttendanceData(resource.data)
          ) &&
          validAttendanceSelfUpdate()
        )
      );
      allow delete: if isRealUser() && (
        isProjectManager() || isConfigAdmin() || isSuperAdmin() ||
        (resource != null && resource.data.get('date', '') < '2026-07-27')
      );
    }

    // ── 4. Leave & WFH Requests (Direct CEO -> CTO Hierarchy) ───────────────
    //
    // CREATE: Employee self-submit uses ownsLeaveRequest (employeeUid == auth.uid,
    //         zero cross-doc reads). PM and HR may also submit representative requests
    //         on behalf of team members (PMProfileView / HRProfileView workflows).
    //         Super Admins always have full access.
    //
    // UPDATE: Only isSuperAdmin() may change approval-stage fields (ceoStatus/ctoStatus).
    //         Employees may self-cancel: status -> 'Cancelled' while all stage-status
    //         fields remain unchanged (ceoStatus, ctoStatus, pmStatus, hrStatus).
    //
    match /leaveRequests/{requestId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        isProjectManager() ||
        isHrAdmin() ||
        (isRealUser() && ownsLeaveRequest(request.resource.data) && validLeaveShape())
      );

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          isRealUser() &&
          ownsLeaveRequest(resource.data) &&
          request.resource.data.get('status', '') == 'Cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          unchanged('ceoStatus') &&
          unchanged('ctoStatus') &&
          unchanged('pmStatus') &&
          unchanged('hrStatus')
        )
      );

      allow delete: if isSuperAdmin() || isConfigAdmin() || (
        isRealUser() && ownsLeaveRequest(resource.data) &&
        resource.data.get('status', '') in ['Pending', 'Cancelled']
      );
    }

    // ── 5. Salary Disbursements (payroll) ────────────────────────────────────
    match /salaryDisbursements/{recordId} {
      allow read: if isRealUser() && (isHrAdmin() || isSuperAdmin() || isProjectManager() || ownsSalaryRecord(resource.data));
      allow create, update: if isHrAdmin() || isSuperAdmin() || isProjectManager();
      allow delete: if isSuperAdmin();
    }

    // ── 6. Notifications ─────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isRealUser();
      allow create: if isRealUser() && (
        !('ALL' in request.resource.data.get('audience',[])) ||
        isProjectManager() || isConfigAdmin()
      );
      allow update: if isRealUser() && (
        isConfigAdmin() ||
        isProjectManager() ||
        ownsNotification(resource.data) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'readBy', 'updatedAt'])
      );
      allow delete: if isRealUser() && (isHrAdmin() || isSuperAdmin() || isProjectManager() || ownsNotification(resource.data));
    }

    // ── 7. FCM Push Tokens ───────────────────────────────────────────────────
    match /fcmTokens/{tokenId} {
      allow read: if isConfigAdmin() || isProjectManager();
      allow create, update: if isRealUser();
      allow delete: if isRealUser() && (isConfigAdmin() || isProjectManager() || ownsFcmToken(resource.data));
    }

    // ── 8. Settings ──────────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if isRealUser();
      allow create, update: if isConfigAdmin() || isProjectManager();
      allow delete: if isSuperAdmin();
    }

    // ── 9. Company Config (WFH dates & global policies) ──────────────────────
    match /companyConfig/{configId} {
      allow read: if isRealUser();
      allow create, update, delete: if isSuperAdmin() || isConfigAdmin() || isProjectManager();
    }

    // ── 10. Company Rules (HR handbook) ──────────────────────────────────────
    match /companyRules/{ruleId} {
      allow read: if isRealUser();
      allow create, update, delete: if isConfigAdmin() || isProjectManager();
    }

    // ── 11. Work Zones (geo-fence) ───────────────────────────────────────────
    match /workZones/{zoneId} {
      allow read: if isRealUser();
      allow create, update: if isConfigAdmin() || isProjectManager();
      allow delete: if isSuperAdmin();
    }

    // ── 12. Projects ─────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if isRealUser();
      allow create, update, delete: if isProjectManager() || isConfigAdmin();
    }

    // ── 13. Kanban Tasks ─────────────────────────────────────────────────────
    match /projectTasks/{taskId} {
      allow read, create, update: if isRealUser();
      allow delete: if isProjectManager() || isConfigAdmin() || (
        isRealUser() && resource != null && (
          resource.data.get('createdByUid', '~') == request.auth.uid ||
          resource.data.get('assignedToUid', '~') == request.auth.uid ||
          resource.data.get('employeeUid', '~') == request.auth.uid
        )
      );
    }

    // ── 14. 1:1 Manager Notes (PM-private) ───────────────────────────────────
    match /oneOnOneNotes/{noteId} {
      allow read: if isProjectManager() || isConfigAdmin() ||
        (isRealUser() && resource != null && (
          resource.data.get('employeeId','~') == getEmployeeId() ||
          resource.data.get('employeeId','~') == getEmployeeDocId() ||
          resource.data.get('employeeUid','~') == request.auth.uid ||
          (getEmployeeDocId() != null && resource.data.get('employeeDocId','~') == getEmployeeDocId()) ||
          resource.data.get('employeeId','~') == request.auth.uid ||
          (hasEmail() && resource.data.get('employeeEmail','~').lower() == userEmail().lower())
        ));
      allow create, update: if isProjectManager() || isConfigAdmin();
      allow delete: if isConfigAdmin() || isProjectManager();
    }

    // ── 15. Audit Logs (append-only) ─────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isConfigAdmin() || isProjectManager();
      allow create: if isRealUser() && validAuditShape();
      allow update, delete: if false;
    }

    // ── 16. Error Diagnostics ────────────────────────────────────────────────
    match /error_logs/{logId} {
      allow read: if isConfigAdmin() || isProjectManager();
      allow create: if
        request.resource.data.keys().hasOnly([
          'timestamp','timestampMs','category','message','stack',
          'uid','employeeId','role','deviceCategory','browser','os',
          'network','route','appVersion','buildVersion','userAgent',
          'operationType','path'
        ]) &&
        request.resource.data.get('message', '') is string &&
        request.resource.data.get('message', '').size() <= 500;
      allow update, delete: if false;
    }

    // ── 17. Performance Appraisals ───────────────────────────────────────────
    match /performanceFeedbacks/{feedbackId} {
      function isSubject() {
        return isRealUser() && (
          resource.data.targetEmployeeId == request.auth.uid ||
          resource.data.get('targetEmployeeUid', '') == request.auth.uid ||
          (getEmployeeDocId() != null && (resource.data.targetEmployeeId == getEmployeeDocId() || resource.data.get('targetEmployeeDocId', '~') == getEmployeeDocId())) ||
          (getEmployeeId() != null && (resource.data.targetEmployeeCode == getEmployeeId() || resource.data.targetEmployeeId == getEmployeeId())) ||
          (hasEmail() && (
            (resource.data.get('targetEmployeeEmail', '') != '' && (resource.data.get('targetEmployeeEmail', '') == userEmail() || resource.data.get('targetEmployeeEmail', '').lower() == userEmail().lower())) ||
            (resource.data.get('email', '') != '' && (resource.data.get('email', '') == userEmail() || resource.data.get('email', '').lower() == userEmail().lower()))
          )) ||
          (exists(/databases/$(database)/documents/employees/$(resource.data.targetEmployeeId)) &&
           (get(/databases/$(database)/documents/employees/$(resource.data.targetEmployeeId)).data.get('uid', '') == request.auth.uid ||
            (hasEmail() && get(/databases/$(database)/documents/employees/$(resource.data.targetEmployeeId)).data.get('email', '').lower() == userEmail().lower()))) ||
          (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
           (get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('employeeId', '') == resource.data.get('targetEmployeeCode', '~') ||
            get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('id', '') == resource.data.targetEmployeeId ||
            (hasEmail() && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('email', '').lower() == userEmail().lower()))) ||
          (userDocExists() && (
            getUserDoc().get('employeeId', '') == resource.data.get('targetEmployeeCode', '~') ||
            getUserDoc().get('employeeDocId', '') == resource.data.targetEmployeeId ||
            (hasEmail() && getUserDoc().get('email', '').lower() == userEmail().lower())
          ))
        );
      }
      function isAcknowledgementOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['isAcknowledged', 'acknowledgedAt', 'updatedAt']) &&
               request.resource.data.isAcknowledged == true;
      }
      function isAuthor() {
        return isRealUser() && (
          resource.data.reviewerId == request.auth.uid ||
          resource.data.get('reviewerUid', '') == request.auth.uid ||
          (getEmployeeDocId() != null && resource.data.reviewerId == getEmployeeDocId()) ||
          (getEmployeeId() != null && resource.data.reviewerId == getEmployeeId()) ||
          isAuthorizedTechLead() ||
          (exists(/databases/$(database)/documents/employees/$(resource.data.reviewerId)) &&
           (get(/databases/$(database)/documents/employees/$(resource.data.reviewerId)).data.get('uid', '') == request.auth.uid ||
            (hasEmail() && get(/databases/$(database)/documents/employees/$(resource.data.reviewerId)).data.get('email', '').lower() == userEmail().lower())))
        );
      }
      function callerTier() {
        return isSuperAdmin() ? 5 : (isHrAdmin() ? 3 : (isProjectManager() ? 2 : 1));
      }
      allow read: if isConfigAdmin() || isSubject() || isAuthor() || isAuthorizedTechLead() ||
        (isProjectManager() && resource.data.subjectTier == 1);
      allow create: if (isConfigAdmin() || isProjectManager() || isAuthorizedTechLead()) &&
        request.resource.data.reviewerId is string &&
        (
          request.resource.data.reviewerId == request.auth.uid ||
          (getEmployeeDocId() != null && request.resource.data.reviewerId == getEmployeeDocId()) ||
          (getEmployeeId() != null && request.resource.data.reviewerId == getEmployeeId()) ||
          isAuthorizedTechLead() ||
          isConfigAdmin() ||
          (exists(/databases/$(database)/documents/employees/$(request.resource.data.reviewerId)) &&
            (get(/databases/$(database)/documents/employees/$(request.resource.data.reviewerId)).data.get('uid', '') == request.auth.uid ||
            (hasEmail() && get(/databases/$(database)/documents/employees/$(request.resource.data.reviewerId)).data.get('email', '').lower() == userEmail().lower())))
        ) &&
        request.resource.data.targetEmployeeId is string &&
        request.resource.data.targetEmployeeId.size() > 0 &&
        request.resource.data.targetEmployeeId != request.resource.data.reviewerId &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.isAcknowledged == false &&
        request.resource.data.subjectTier is number &&
        request.resource.data.subjectTier >= 1 &&
        (isAuthorizedTechLead() || isConfigAdmin() || request.resource.data.subjectTier < callerTier());
      allow update: if
        ((isConfigAdmin() || isAuthorizedTechLead() || isProjectManager()) && unchanged('reviewerId') && unchanged('targetEmployeeId') && unchanged('subjectTier')) ||
        (isAuthor() && unchanged('reviewerId') && unchanged('targetEmployeeId') && unchanged('subjectTier')) ||
        (isSubject() && isAcknowledgementOnly()) ||
        (isRealUser() && isAcknowledgementOnly() && unchanged('reviewerId') && unchanged('targetEmployeeId') && unchanged('subjectTier'));
      allow delete: if isConfigAdmin() ||
        (isAuthor() && resource.data.get('isAcknowledged', false) == false);

      match /confidential/{noteId} {
        allow read, write: if isConfigAdmin();
      }
    }

    // ── 18. Feedback Quizzes ─────────────────────────────────────────────────
    match /feedbackQuizzes/{quizId} {
      allow read: if isRealUser();
      allow create, delete: if isRealUser() && (isSuperAdmin() || isHrAdmin() || isProjectManager());
      allow update: if isRealUser() && (
        isSuperAdmin() || isHrAdmin() || isProjectManager() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount','updatedAt'])
      );

      match /responses/{responseId} {
        allow read: if isRealUser() && (
          isSuperAdmin() || isHrAdmin() || isProjectManager() ||
          (resource != null && (
            resource.data.get('employeeUid','~') == request.auth.uid ||
            resource.data.get('uid','~') == request.auth.uid ||
            resource.data.get('employeeId','~') == request.auth.uid ||
            (getEmployeeDocId() != null && resource.data.get('employeeId','~') == getEmployeeDocId()) ||
            (getEmployeeId() != null && resource.data.get('employeeId','~') == getEmployeeId())
          ))
        );
        allow create: if isRealUser() && (
          request.resource.data.get('employeeUid','~') == request.auth.uid ||
          request.resource.data.get('uid','~') == request.auth.uid ||
          request.resource.data.get('employeeId','~') == request.auth.uid ||
          (getEmployeeDocId() != null && request.resource.data.get('employeeId','~') == getEmployeeDocId()) ||
          (getEmployeeId() != null && request.resource.data.get('employeeId','~') == getEmployeeId()) ||
          isProjectManager() || isConfigAdmin()
        );
        allow update: if isRealUser() && (
          resource.data.get('employeeUid','~') == request.auth.uid ||
          resource.data.get('uid','~') == request.auth.uid ||
          resource.data.get('employeeId','~') == request.auth.uid ||
          (getEmployeeDocId() != null && resource.data.get('employeeId','~') == getEmployeeDocId()) ||
          (getEmployeeId() != null && resource.data.get('employeeId','~') == getEmployeeId()) ||
          isProjectManager() || isConfigAdmin()
        );
        allow delete: if isSuperAdmin() || isConfigAdmin() || isProjectManager();
      }
    }

    // ── 19. Work Schedules (per-employee shift/break config) ─────────────────
    match /workSchedules/{employeeId} {
      allow read: if isRealUser();
      allow create, update: if isProjectManager() || isHrAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── 20. WFH Allowances (monthly per-employee WFH quota) ──────────────────
    match /wfhAllowances/{employeeId} {
      allow read: if isRealUser();
      allow write: if isProjectManager() || isConfigAdmin();

      match /months/{monthKey} {
        allow read: if isRealUser();
        allow create, update: if isProjectManager() || isHrAdmin();
        allow delete: if isSuperAdmin() || isProjectManager();
      }
    }

  }
}