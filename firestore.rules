rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 1. Core Authentication & Identity Helpers ────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isRealUser() {
      return isSignedIn();
    }

    function hasEmail() {
      return isSignedIn() && ('email' in request.auth.token) && request.auth.token.email != null;
    }

    function userEmail() {
      return hasEmail() ? request.auth.token.email.lower() : '';
    }

    function emailMatches(targetEmail) {
      return hasEmail() && targetEmail is string && targetEmail != '' &&
        targetEmail.lower() == userEmail();
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function unchanged(f) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([f]);
    }

    // ── 2. Canonical User Document & Role Resolution ─────────────────────────
    // Reads users/{uid} at most ONCE per request evaluation (Firestore rules engine
    // automatically caches repeated get() calls to the same path within a transaction).
    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function getStoredRole() {
      return userDocExists() && ('role' in getUserDoc()) && getUserDoc().role is string
        ? getUserDoc().role.lower()
        : '';
    }

    function getClaimRole() {
      return isSignedIn() && ('role' in request.auth.token) && request.auth.token.role is string
        ? request.auth.token.role.lower()
        : '';
    }

    function getRole() {
      return getClaimRole() != '' ? getClaimRole() : getStoredRole();
    }

    // ── 3. Bootstrap Administrative Fallbacks (Cold-start safety) ────────────
    // Prevents the cold-start bootstrap deadlock when an executive or administrator
    // logs in for the first time before users/{uid} has been written.
    function isBootstrapAdmin() {
      return hasEmail() && userEmail() in [
        'gaurav@kalpanaaa.in', 'gaurav@kalpanaaasoftwaresolutions.in',
        'founder@kalpanaaasoftwaresolutions.in', 'founder@kalpanaaa.in',
        'akshitujjain@kalpanaaasoftwaresolutions.in', 'akshit.ujjain@kalpanaaasoftwaresolutions.in',
        'akshit@kalpanaaa.in', 'akshit.ujjain@kalpanaaa.in',
        'cto@kalpanaaa.in', 'cto@kalpanaaasoftwaresolutions.in'
      ];
    }

    function isBootstrapHr() {
      return hasEmail() && userEmail() in [
        'hr@kalpanaaa.in', 'hr@kalpanaaasoftwaresolutions.in',
        'abhinayav1919@kalpanaaa.in', 'abhinayav1919@kalpanaaasoftwaresolutions.in'
      ];
    }

    function isBootstrapPm() {
      return hasEmail() && userEmail() in [
        'd.koushik@kalpanaaasoftwaresolutions.in', 'd.koushik@kalpanaaa.in',
        'koushik@kalpanaaa.in', 'koushik@kalpanaaasoftwaresolutions.in'
      ];
    }

    function isBootstrapTechLead() {
      return hasEmail() && userEmail() in [
        'satya.ranjan.dash@kalpanaaa.in', 'satya.ranjan.das@kalpanaaa.in', 'satya@kalpanaaa.in',
        'satya.ranjan.dash@kalpanaaasoftwaresolutions.in',
        'jasonkennethn@kalpanaaa.in', 'jason.kennethn@kalpanaaa.in', 'jasonkennethn@kalpanaaasoftwaresolutions.in'
      ];
    }

    // ── 4. Unified Role Predicates (Hierarchy: SuperAdmin > HR > PM > Employee)
    function isSuperAdmin() {
      return isSignedIn() && (
        getRole() in ['super_admin', 'superadmin', 'admin'] ||
        isBootstrapAdmin() ||
        request.auth.uid in ['2kNsj2o55VRtEy2rTnz4CPk7se23', 'sco3JJEikROXFMSkCbe7flK62w53', 'hOjKhSAtZKN7igNaePAmPKprVbp1']
      );
    }

    function isHrAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        getRole() in ['hr_admin', 'hr'] ||
        isBootstrapHr() ||
        request.auth.uid in ['2d48Rm9eY4eBswXOZw2IBpWGkZK2', '3ZHI3aTB37StHjR97WEBJQSWT9H3']
      );
    }

    function isProjectManager() {
      return isSignedIn() && (
        isSuperAdmin() ||
        getRole() in ['project_manager', 'pm'] ||
        isBootstrapPm() ||
        request.auth.uid in ['vhKLIJCVZoTncqVtmh14paMbiXk2']
      );
    }

    function isConfigAdmin() {
      return isHrAdmin() || isSuperAdmin();
    }

    function isAuthorizedTechLead() {
      return isSignedIn() && (
        isSuperAdmin() ||
        getStoredRole() in ['tech_lead', 'technical_lead'] ||
        isBootstrapTechLead() ||
        request.auth.uid in ['QpDtyS6Jp5OqNu3klvfWGoWHfmS2', 'KfAB95lpbJOeylpKQaWX4GXOPGt2']
      );
    }

    function isAttendanceManager() {
      return isProjectManager() || isHrAdmin() || isSuperAdmin() ||
        isBootstrapAdmin() || isBootstrapHr() || isBootstrapPm() ||
        (isSignedIn() && request.auth.uid in [
          '2kNsj2o55VRtEy2rTnz4CPk7se23', 'sco3JJEikROXFMSkCbe7flK62w53',
          'hOjKhSAtZKN7igNaePAmPKprVbp1', 'vhKLIJCVZoTncqVtmh14paMbiXk2',
          '2d48Rm9eY4eBswXOZw2IBpWGkZK2', '3ZHI3aTB37StHjR97WEBJQSWT9H3'
        ]);
    }

    // ── 5. Employee Corporate Identity Mappings ──────────────────────────────
    function getEmployeeId() {
      return userDocExists() && getUserDoc().get('employeeId', null) != null
        ? getUserDoc().get('employeeId', null)
        : null;
    }

    function getEmployeeDocId() {
      return userDocExists() && getUserDoc().get('employeeDocId', null) != null
        ? getUserDoc().get('employeeDocId', null)
        : null;
    }

    // ── 6. Zero-Read and Single-Read Ownership Helpers ───────────────────────
    function ownsEmployeeRecord(employeeId) {
      return isSignedIn() && (
        request.auth.uid == employeeId ||
        (resource != null && (
          resource.data.get('uid', '~') == request.auth.uid ||
          resource.data.get('employeeUid', '~') == request.auth.uid ||
          emailMatches(resource.data.get('email', '')) ||
          emailMatches(resource.data.get('workEmail', '')) ||
          emailMatches(resource.data.get('personalEmail', ''))
        )) ||
        (getEmployeeDocId() != null && employeeId == getEmployeeDocId()) ||
        (getEmployeeId() != null && (employeeId == getEmployeeId() || employeeId == ('emp-' + getEmployeeId())))
      );
    }

    function isAttendanceRecordOwner(recordId, d) {
      return isSignedIn() && (
        d.get('authUid', '~') == request.auth.uid ||
        d.get('uid', '~') == request.auth.uid ||
        d.get('employeeUid', '~') == request.auth.uid ||
        d.get('employeeId', '~') == request.auth.uid ||
        emailMatches(d.get('email', '')) ||
        emailMatches(d.get('employeeEmail', '')) ||
        (getEmployeeId() != null && (
          d.get('employeeCode', '~') == getEmployeeId() ||
          d.get('employeeId', '~') == getEmployeeId() ||
          d.get('employeeId', '~') == ('emp-' + getEmployeeId()) ||
          (d.get('date', '') != '' && (
            recordId == (getEmployeeId() + '_' + d.get('date', '')) ||
            recordId == ('emp-' + getEmployeeId() + '_' + d.get('date', ''))
          ))
        )) ||
        (getEmployeeDocId() != null && (
          d.get('employeeId', '~') == getEmployeeDocId() ||
          d.get('employeeDocId', '~') == getEmployeeDocId() ||
          (d.get('date', '') != '' && recordId == (getEmployeeDocId() + '_' + d.get('date', '')))
        ))
      );
    }

    function ownsSalaryRecord(d) {
      return isRealUser() && (
        d.get('employeeUid', '~') == request.auth.uid ||
        d.get('uid', '~') == request.auth.uid ||
        d.get('employeeId', '~') == request.auth.uid ||
        emailMatches(d.get('email', '')) ||
        emailMatches(d.get('employeeEmail', '')) ||
        (getEmployeeId() != null && (
          d.get('employeeId', '~') == getEmployeeId() ||
          d.get('employeeId', '~') == ('emp-' + getEmployeeId())
        )) ||
        (getEmployeeDocId() != null && (
          d.get('employeeDocId', '~') == getEmployeeDocId() ||
          d.get('employeeId', '~') == getEmployeeDocId()
        ))
      );
    }

    function ownsFcmToken(d) {
      return isRealUser() && (
        d.get('uid', '~') == request.auth.uid ||
        d.get('employeeUid', '~') == request.auth.uid ||
        d.get('employeeId', '~') == request.auth.uid ||
        (getEmployeeId() != null && d.get('employeeId', '~') == getEmployeeId()) ||
        (getEmployeeDocId() != null && d.get('employeeId', '~') == getEmployeeDocId())
      );
    }

    function ownsNotification(d) {
      return isRealUser() && (
        d.get('recipientUid', '~') == request.auth.uid ||
        d.get('targetEmployeeUid', '~') == request.auth.uid ||
        d.get('targetEmployeeId', '~') == request.auth.uid ||
        d.get('actorId', '~') == request.auth.uid ||
        d.get('createdByUid', '~') == request.auth.uid ||
        (getEmployeeId() != null && (
          d.get('recipientEmployeeId', '~') == getEmployeeId() ||
          d.get('targetEmployeeId', '~') == getEmployeeId() ||
          d.get('actorId', '~') == getEmployeeId()
        )) ||
        (getEmployeeDocId() != null && (
          d.get('recipientEmployeeId', '~') == getEmployeeDocId() ||
          d.get('targetEmployeeId', '~') == getEmployeeDocId() ||
          d.get('actorId', '~') == getEmployeeDocId()
        ))
      );
    }

    // ── 7. Document Schema Validators ────────────────────────────────────────
    function validAttendanceShape() {
      let d = request.resource.data;
      return (!('status' in d) || d.status is string) &&
             (!('date' in d) || (d.date is string && d.date.size() == 10));
    }

    function validLeaveShape() {
      let d = request.resource.data;
      return d.keys().hasAll(['employeeId', 'employeeUid', 'type', 'startDate', 'endDate', 'reason', 'status']) &&
      (
        d.get('employeeUid', '') == request.auth.uid ||
        d.get('authUid', '') == request.auth.uid ||
        emailMatches(d.get('email', '')) ||
        emailMatches(d.get('employeeEmail', ''))
      ) &&
      (d.get('authUid', '~') == '~' || d.get('authUid', '~') == request.auth.uid) &&
      d.get('status', '') == 'Pending' &&
      d.get('type', '') in [
        'Leave', 'WFH', 'Earn Leave', 'Sick Leave', 'Loss of Pay',
        'Casual Leave', 'EL', 'SL', 'LOP'
      ] &&
      d.get('startDate', '') is string && d.get('startDate', '').size() == 10 &&
      d.get('endDate', '') is string && d.get('endDate', '').size() == 10 &&
      d.get('reason', '') is string && d.get('reason', '').size() > 0 &&
      d.get('ceoStatus', '') != 'Approved' &&
      d.get('ctoStatus', '') != 'Approved' &&
      d.get('pmStatus', '') != 'Approved' &&
      d.get('hrStatus', '') != 'Approved' &&
      d.get('_deductionApplied', false) == false;
    }

    function validAuditShape() {
      return request.resource.data.keys().hasOnly([
        'id','actorId','actorName','actorRole','action','target','details','timestamp',
        'performedBy','performedByUid','targetEmployee','targetEmployeeUid',
        'role','ipAddress','userAgent','sessionId','monthKey'
      ]) &&
      request.resource.data.get('action','') is string &&
      request.resource.data.get('action','').size() <= 120 &&
      request.resource.data.get('details','') is string &&
      request.resource.data.get('details','').size() <= 5000;
    }

    // ── 0. Connectivity probe (pre-auth) ─────────────────────────────────────
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── 1. Users (canonical role mapping & auth profile) ─────────────────────
    match /users/{userId} {
      allow read: if isSelf(userId) || isHrAdmin() || isProjectManager() || isSuperAdmin();
      allow create, update: if (
        isSelf(userId) && (
          // Regular users cannot escalate themselves to administrative roles
          !(request.resource.data.get('role', 'EMPLOYEE').lower() in [
            'super_admin', 'superadmin', 'admin', 'hr_admin', 'hr', 'project_manager', 'pm'
          ]) ||
          // Authorized administrative roles & bootstrap accounts can write their valid role
          isSuperAdmin() || isHrAdmin() || isProjectManager() || isBootstrapAdmin() || isBootstrapHr() || isBootstrapPm()
        ) &&
        request.resource.data.get('uid', request.auth.uid) == request.auth.uid
      ) || isSuperAdmin() || isHrAdmin() || isProjectManager();
      allow delete: if isSuperAdmin() || isHrAdmin();
    }

    // ── 2. Employees Directory (PII, biometrics, leave balances) ─────────────
    match /employees/{employeeId} {
      allow read: if isRealUser();
      allow create: if isSuperAdmin() || isHrAdmin() || isProjectManager() || (
        isRealUser() && isSelf(employeeId) && (
          request.resource.data.get('role', 'EMPLOYEE').lower() == 'employee' ||
          (userDocExists() && getUserDoc().get('role', '').lower() == request.resource.data.get('role', '').lower())
        )
      );
      allow update: if (
        (request.auth.uid == employeeId || ownsEmployeeRecord(employeeId)) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'profilePhotoUrl', 'bio', 'phone', 'gender', 'dateOfBirth',
            'permanentAddress', 'currentAddress', 'city', 'state', 'postalCode',
            'emergencyContact', 'emergencyRelationship', 'skills', 'specialization',
            'preferredShift', 'linkedinUrl', 'faceDescriptor', 'isFaceEnrolled',
            'faceEnrolledAt', 'fullName', 'updatedAt', 'hasResume', 'resumeUrl',
            'desktopSessionId', 'mobileSessionId', 'currentSessionId',
            'sessionFingerprint', 'lastLoginAt', 'lastActiveAt',
            'uid'
          ])
        )
      ) ||
      isProjectManager() || isConfigAdmin() || isAuthorizedTechLead() ||
      // Approver leave deduction atomically updating balances on approval
      ((isSuperAdmin() || isHrAdmin()) &&
       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
         'earnLeaveBalance', 'sickLeaveBalance', 'casualLeaveBalance', 'updatedAt'
       ]));

      allow delete: if isSuperAdmin() || isHrAdmin();

      // 2a. Leave date-locks (atomic reservation prevents double-booking)
      match /leaveLocks/{lockDate} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && (
          request.resource.data.get('employeeUid', '~') == request.auth.uid ||
          request.resource.data.get('authUid', '~') == request.auth.uid ||
          employeeId == request.auth.uid ||
          request.resource.data.get('employeeId', '~') == request.auth.uid ||
          emailMatches(request.resource.data.get('email', '')) ||
          emailMatches(request.resource.data.get('employeeEmail', '')) ||
          isAttendanceManager()
        );
        allow delete: if isSignedIn() && (
          employeeId == request.auth.uid ||
          (resource != null && (
            resource.data.get('employeeUid', '~') == request.auth.uid ||
            resource.data.get('authUid', '~') == request.auth.uid ||
            resource.data.get('employeeId', '~') == request.auth.uid ||
            emailMatches(resource.data.get('email', '')) ||
            emailMatches(resource.data.get('employeeEmail', ''))
          )) ||
          isAttendanceManager()
        );
      }

      // 2b. Private resume subcollection
      match /private/{docId} {
        allow read, write: if isConfigAdmin() || isProjectManager() ||
          (isRealUser() && (employeeId == request.auth.uid || employeeId == getEmployeeDocId() || ownsEmployeeRecord(employeeId)));
      }

      // 2c. Leave Ledger subcollection (immutable audit trail of credits/debits)
      match /leaveLedger/{txnId} {
        allow read: if isRealUser();
        allow create: if isSignedIn() && (
          isConfigAdmin() || isProjectManager() || isSuperAdmin() ||
          employeeId == request.auth.uid ||
          (getEmployeeDocId() != null && employeeId == getEmployeeDocId()) ||
          (getEmployeeId() != null && (employeeId == getEmployeeId() || employeeId == ('emp-' + getEmployeeId()))) ||
          request.resource.data.get('employeeUid', '~') == request.auth.uid ||
          request.resource.data.get('authUid', '~') == request.auth.uid ||
          emailMatches(request.resource.data.get('email', '')) ||
          emailMatches(request.resource.data.get('employeeEmail', ''))
        );
        allow update, delete: if isSuperAdmin() || isConfigAdmin() || isProjectManager();
      }
    }

    // ── 3. Attendance Records ────────────────────────────────────────────────
    match /attendance/{recordId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        // Fast-path 1: employee self-create (0 reads)
        (
          validAttendanceShape() &&
          (
            request.resource.data.get('date', '') == '' ||
            request.resource.data.get('date', '') >= '2026-07-27'
          ) && (
            request.resource.data.get('authUid', '~') == request.auth.uid ||
            request.resource.data.get('employeeUid', '~') == request.auth.uid ||
            request.resource.data.get('uid', '~') == request.auth.uid ||
            request.resource.data.get('employeeId', '~') == request.auth.uid ||
            emailMatches(request.resource.data.get('email', '')) ||
            emailMatches(request.resource.data.get('employeeEmail', ''))
          )
        ) ||
        // Fast-path 2: manager correction carrying correctedByUid or pmUid in payload
        request.resource.data.get('correctedByUid', '~') == request.auth.uid ||
        request.resource.data.get('pmUid', '~') == request.auth.uid ||
        isAttendanceManager() ||
        isProjectManager() ||
        isAttendanceRecordOwner(recordId, request.resource.data)
      );

      allow update: if isSignedIn() && (
        // Fast-path 1: employee self-update via payload (0 reads)
        request.resource.data.get('authUid', '~') == request.auth.uid ||
        request.resource.data.get('employeeUid', '~') == request.auth.uid ||
        request.resource.data.get('uid', '~') == request.auth.uid ||
        request.resource.data.get('employeeId', '~') == request.auth.uid ||
        emailMatches(request.resource.data.get('email', '')) ||
        emailMatches(request.resource.data.get('employeeEmail', '')) ||
        // Fast-path 2: existing doc ownership (0 reads on stored fields)
        (resource != null && (
          resource.data.get('authUid', '~') == request.auth.uid ||
          resource.data.get('employeeUid', '~') == request.auth.uid ||
          resource.data.get('uid', '~') == request.auth.uid ||
          resource.data.get('employeeId', '~') == request.auth.uid ||
          emailMatches(resource.data.get('email', '')) ||
          emailMatches(resource.data.get('employeeEmail', ''))
        )) ||
        // Fast-path 3: manager correction
        request.resource.data.get('correctedByUid', '~') == request.auth.uid ||
        request.resource.data.get('pmUid', '~') == request.auth.uid ||
        (resource != null && resource.data.get('pmUid', '~') == request.auth.uid) ||
        isAttendanceManager() ||
        isProjectManager() ||
        isAttendanceRecordOwner(recordId, request.resource.data) ||
        (resource != null && isAttendanceRecordOwner(recordId, resource.data))
      );

      allow delete: if isAttendanceManager() || isProjectManager() || isConfigAdmin() || (
        isSignedIn() && resource != null && resource.data.get('date', '') < '2026-07-27'
      );
    }

    // ── 4. Leave & WFH Requests ──────────────────────────────────────────────
    match /leaveRequests/{requestId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        // Fast-path 1: Employee self-submit — UID or email match, 0 reads
        (
          isRealUser() &&
          (
            request.resource.data.get('employeeUid', '~') == request.auth.uid ||
            request.resource.data.get('authUid', '~') == request.auth.uid ||
            emailMatches(request.resource.data.get('email', '')) ||
            emailMatches(request.resource.data.get('employeeEmail', ''))
          ) &&
          validLeaveShape()
        ) ||
        isSuperAdmin() || isProjectManager() || isHrAdmin()
      );

      allow update: if isSignedIn() && (
        // Fast-path 1: Employee self-cancel (UID or email anchored, status=Cancelled)
        (
          resource != null &&
          (
            resource.data.get('employeeUid', '~') == request.auth.uid ||
            resource.data.get('authUid', '~') == request.auth.uid ||
            emailMatches(resource.data.get('email', '')) ||
            emailMatches(resource.data.get('employeeEmail', ''))
          ) &&
          request.resource.data.get('status', '') == 'Cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelledAt', 'cancelledBy'])
        ) ||
        // Fast-path 2: Approvers update stages, notes, statuses, deduction flags
        isSuperAdmin() || isProjectManager() || isHrAdmin() ||
        // Fast-path 3: Employee self-update / resubmit (valid shape, UID/email anchored)
        (
          (
            request.resource.data.get('employeeUid', '~') == request.auth.uid ||
            request.resource.data.get('authUid', '~') == request.auth.uid ||
            emailMatches(request.resource.data.get('email', '')) ||
            emailMatches(request.resource.data.get('employeeEmail', ''))
          ) &&
          validLeaveShape() &&
          (
            resource == null ||
            resource.data.get('employeeUid', '~') == request.auth.uid ||
            resource.data.get('authUid', '~') == request.auth.uid ||
            emailMatches(resource.data.get('email', '')) ||
            emailMatches(resource.data.get('employeeEmail', ''))
          ) &&
          (resource == null || resource.data.get('status', '') in ['Pending', 'Cancelled', 'Rejected'])
        )
      );

      allow delete: if isSuperAdmin() || isConfigAdmin() || (
        isRealUser() && resource != null &&
        (
          resource.data.get('employeeUid', '~') == request.auth.uid ||
          resource.data.get('authUid', '~') == request.auth.uid ||
          emailMatches(resource.data.get('email', '')) ||
          emailMatches(resource.data.get('employeeEmail', ''))
        ) &&
        resource.data.get('status', '') in ['Pending', 'Cancelled']
      );
    }

    // ── 5. Salary Disbursements (payroll) ────────────────────────────────────
    match /salaryDisbursements/{recordId} {
      allow read: if isRealUser() && (isHrAdmin() || isSuperAdmin() || isProjectManager() || ownsSalaryRecord(resource.data));
      allow create, update: if isHrAdmin() || isSuperAdmin() || isProjectManager();
      allow delete: if isSuperAdmin();
    }

    // ── 6. Notifications ─────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isRealUser();
      allow create: if isRealUser() && (
        !('ALL' in request.resource.data.get('audience',[])) ||
        isProjectManager() || isConfigAdmin()
      );
      allow update: if isRealUser() && (
        isConfigAdmin() ||
        isProjectManager() ||
        ownsNotification(resource.data) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'readBy', 'updatedAt'])
      );
      allow delete: if isRealUser() && (isHrAdmin() || isSuperAdmin() || isProjectManager() || ownsNotification(resource.data));
    }

    // ── 7. FCM Push Tokens ───────────────────────────────────────────────────
    match /fcmTokens/{tokenId} {
      allow read: if isConfigAdmin() || isProjectManager();
      allow create, update: if isRealUser();
      allow delete: if isRealUser() && (isConfigAdmin() || isProjectManager() || ownsFcmToken(resource.data));
    }

    // ── 8. Settings ──────────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if isRealUser();
      allow create, update: if isConfigAdmin() || isProjectManager();
      allow delete: if isSuperAdmin();
    }

    // ── 9. Company Config (WFH dates & global policies) ──────────────────────
    match /companyConfig/{configId} {
      allow read: if isRealUser();
      allow create, update, delete: if isSuperAdmin() || isConfigAdmin() || isProjectManager();
    }

    // ── 10. Company Rules (HR handbook) ──────────────────────────────────────
    match /companyRules/{ruleId} {
      allow read: if isRealUser();
      allow create, update, delete: if isConfigAdmin() || isProjectManager();
    }

    // ── 11. Work Zones (geo-fence) ───────────────────────────────────────────
    match /workZones/{zoneId} {
      allow read: if isRealUser();
      allow create, update: if isConfigAdmin() || isProjectManager();
      allow delete: if isSuperAdmin();
    }

    // ── 12. Projects ─────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if isRealUser();
      allow create, update, delete: if isProjectManager() || isConfigAdmin();
    }

    // ── 13. Kanban Tasks ─────────────────────────────────────────────────────
    match /projectTasks/{taskId} {
      allow read, create, update: if isRealUser();
      allow delete: if isProjectManager() || isConfigAdmin() || (
        isRealUser() && resource != null && (
          resource.data.get('createdByUid', '~') == request.auth.uid ||
          resource.data.get('assignedToUid', '~') == request.auth.uid ||
          resource.data.get('employeeUid', '~') == request.auth.uid
        )
      );
    }

    // ── 14. 1:1 Manager Notes (PM-private) ───────────────────────────────────
    match /oneOnOneNotes/{noteId} {
      allow read: if isProjectManager() || isConfigAdmin() ||
        (isRealUser() && resource != null && (
          resource.data.get('employeeId','~') == getEmployeeId() ||
          resource.data.get('employeeId','~') == getEmployeeDocId() ||
          resource.data.get('employeeUid','~') == request.auth.uid ||
          (getEmployeeDocId() != null && resource.data.get('employeeDocId','~') == getEmployeeDocId()) ||
          resource.data.get('employeeId','~') == request.auth.uid ||
          (hasEmail() && resource.data.get('employeeEmail','~').lower() == userEmail())
        ));
      allow create, update: if isProjectManager() || isConfigAdmin();
      allow delete: if isConfigAdmin() || isProjectManager();
    }

    // ── 15. Audit Logs (append-only) ─────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isConfigAdmin() || isProjectManager();
      allow create: if isRealUser() && validAuditShape();
      allow update, delete: if false;
    }

    // ── 16. Error Diagnostics ────────────────────────────────────────────────
    match /error_logs/{logId} {
      allow read: if isConfigAdmin() || isProjectManager();
      allow create: if
        request.resource.data.keys().hasOnly([
          'timestamp','timestampMs','category','message','stack',
          'uid','employeeId','role','deviceCategory','browser','os',
          'network','route','appVersion','buildVersion','userAgent',
          'operationType','path'
        ]) &&
        request.resource.data.get('message', '') is string &&
        request.resource.data.get('message', '').size() <= 500;
      allow update, delete: if false;
    }

    // ── 17. Performance Appraisals ───────────────────────────────────────────
    match /performanceFeedbacks/{feedbackId} {
      function isSubject() {
        return isRealUser() && (
          resource.data.targetEmployeeId == request.auth.uid ||
          resource.data.get('targetEmployeeUid', '') == request.auth.uid ||
          (getEmployeeDocId() != null && (resource.data.targetEmployeeId == getEmployeeDocId() || resource.data.get('targetEmployeeDocId', '~') == getEmployeeDocId())) ||
          (getEmployeeId() != null && (resource.data.targetEmployeeCode == getEmployeeId() || resource.data.targetEmployeeId == getEmployeeId() || resource.data.targetEmployeeId == ('emp-' + getEmployeeId()))) ||
          (hasEmail() && (
            (resource.data.get('targetEmployeeEmail', '') != '' && (resource.data.get('targetEmployeeEmail', '') == userEmail() || resource.data.get('targetEmployeeEmail', '').lower() == userEmail())) ||
            (resource.data.get('email', '') != '' && (resource.data.get('email', '') == userEmail() || resource.data.get('email', '').lower() == userEmail()))
          ))
        );
      }
      function isAcknowledgementOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['isAcknowledged', 'acknowledgedAt', 'updatedAt']) &&
               request.resource.data.isAcknowledged == true;
      }
      function isAuthor() {
        return isRealUser() && (
          resource.data.reviewerId == request.auth.uid ||
          resource.data.get('reviewerUid', '') == request.auth.uid ||
          (getEmployeeDocId() != null && resource.data.reviewerId == getEmployeeDocId()) ||
          (getEmployeeId() != null && resource.data.reviewerId == getEmployeeId()) ||
          isAuthorizedTechLead() ||
          (hasEmail() && resource.data.get('reviewerEmail', '') != '' && emailMatches(resource.data.get('reviewerEmail', '')))
        );
      }
      function callerTier() {
        return isSuperAdmin() ? 5 : (isHrAdmin() ? 3 : (isProjectManager() ? 2 : 1));
      }
      allow read: if isConfigAdmin() || isSubject() || isAuthor() || isAuthorizedTechLead() ||
        (isProjectManager() && resource.data.subjectTier == 1);
      allow create: if (isConfigAdmin() || isProjectManager() || isAuthorizedTechLead()) &&
        request.resource.data.reviewerId is string &&
        (
          request.resource.data.reviewerId == request.auth.uid ||
          (getEmployeeDocId() != null && request.resource.data.reviewerId == getEmployeeDocId()) ||
          (getEmployeeId() != null && request.resource.data.reviewerId == getEmployeeId()) ||
          isAuthorizedTechLead() ||
          isConfigAdmin() ||
          (hasEmail() && request.resource.data.get('reviewerEmail', '') != '' && emailMatches(request.resource.data.get('reviewerEmail', '')))
        ) &&
        request.resource.data.targetEmployeeId is string &&
        request.resource.data.targetEmployeeId.size() > 0 &&
        request.resource.data.targetEmployeeId != request.resource.data.reviewerId &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.isAcknowledged == false &&
        request.resource.data.subjectTier is number &&
        request.resource.data.subjectTier >= 1 &&
        (isAuthorizedTechLead() || isConfigAdmin() || request.resource.data.subjectTier < callerTier());
      allow update: if
        ((isConfigAdmin() || isAuthorizedTechLead() || isProjectManager()) && unchanged('reviewerId') && unchanged('targetEmployeeId') && unchanged('subjectTier')) ||
        (isAuthor() && unchanged('reviewerId') && unchanged('targetEmployeeId') && unchanged('subjectTier')) ||
        (isSubject() && isAcknowledgementOnly()) ||
        (isRealUser() && isAcknowledgementOnly() && unchanged('reviewerId') && unchanged('targetEmployeeId') && unchanged('subjectTier'));
      allow delete: if isConfigAdmin() ||
        (isAuthor() && resource.data.get('isAcknowledged', false) == false);

      match /confidential/{noteId} {
        allow read, write: if isConfigAdmin();
      }
    }

    // ── 18. Feedback Quizzes ─────────────────────────────────────────────────
    match /feedbackQuizzes/{quizId} {
      allow read: if isRealUser();
      allow create, delete: if isRealUser() && (isSuperAdmin() || isHrAdmin() || isProjectManager());
      allow update: if isRealUser() && (
        isSuperAdmin() || isHrAdmin() || isProjectManager() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount','updatedAt'])
      );

      match /responses/{responseId} {
        allow read: if isRealUser() && (
          isSuperAdmin() || isHrAdmin() || isProjectManager() ||
          (resource != null && (
            resource.data.get('employeeUid','~') == request.auth.uid ||
            resource.data.get('uid','~') == request.auth.uid ||
            resource.data.get('employeeId','~') == request.auth.uid ||
            (getEmployeeDocId() != null && resource.data.get('employeeId','~') == getEmployeeDocId()) ||
            (getEmployeeId() != null && resource.data.get('employeeId','~') == getEmployeeId())
          ))
        );
        allow create: if isRealUser() && (
          request.resource.data.get('employeeUid','~') == request.auth.uid ||
          request.resource.data.get('uid','~') == request.auth.uid ||
          request.resource.data.get('employeeId','~') == request.auth.uid ||
          (getEmployeeDocId() != null && request.resource.data.get('employeeId','~') == getEmployeeDocId()) ||
          (getEmployeeId() != null && request.resource.data.get('employeeId','~') == getEmployeeId()) ||
          isProjectManager() || isConfigAdmin()
        );
        allow update: if isRealUser() && (
          resource.data.get('employeeUid','~') == request.auth.uid ||
          resource.data.get('uid','~') == request.auth.uid ||
          resource.data.get('employeeId','~') == request.auth.uid ||
          (getEmployeeDocId() != null && resource.data.get('employeeId','~') == getEmployeeDocId()) ||
          (getEmployeeId() != null && resource.data.get('employeeId','~') == getEmployeeId()) ||
          isProjectManager() || isConfigAdmin()
        );
        allow delete: if isSuperAdmin() || isConfigAdmin() || isProjectManager();
      }
    }

    // ── 19. Work Schedules (per-employee shift/break config) ─────────────────
    match /workSchedules/{employeeId} {
      allow read: if isRealUser();
      allow create, update: if isProjectManager() || isHrAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── 20. WFH Allowances (monthly per-employee WFH quota) ──────────────────
    match /wfhAllowances/{employeeId} {
      allow read: if isRealUser();
      allow write: if isProjectManager() || isConfigAdmin();

      match /months/{monthKey} {
        allow read: if isRealUser();
        allow create, update: if isProjectManager() || isHrAdmin();
        allow delete: if isSuperAdmin() || isProjectManager();
      }
    }

  }
}
